---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout title="页面不存在" description="404 — 你访问的页面不存在。" noindex>
  <div class="container notfound">
    <p class="notfound__code mono" aria-hidden="true">404</p>
    <h1>这里什么也没有</h1>
    <p class="notfound__desc">页面可能被移动、重命名，或者它从来没有存在过。</p>
    <div class="notfound__actions">
      <a class="btn btn--primary" href="/">
        <Icon name="home" size={16} />
        回到首页
      </a>
      <a class="btn btn--ghost" href="/archive/">
        <Icon name="archive" size={16} />
        浏览归档
      </a>
      <button class="btn btn--ghost" type="button" data-search-open>
        <Icon name="search" size={16} />
        搜索文章
      </button>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 58vh;
    padding-top: 60px;
    padding-bottom: 80px;
    text-align: center;
  }

  .notfound__code {
    font-size: clamp(5rem, 14vw, 9rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.06em;
    background: linear-gradient(120deg, var(--accent), var(--violet) 60%, var(--pink));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    opacity: 0.9;
  }

  .notfound h1 {
    margin-top: 6px;
    font-size: clamp(1.5rem, 1.2rem + 1.6vw, 2rem);
    letter-spacing: -0.02em;
  }

  .notfound__desc {
    margin-top: 10px;
    color: var(--text-muted);
    font-size: 14.5px;
  }

  .notfound__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 28px;
  }
</style>
